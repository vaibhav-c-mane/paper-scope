# Copy this file to .env (same folder) and fill in your own values.
# .env stays on your computer: do not share it or put it in a zip you hand in.

# OpenAlex, the main source. A free key (from your OpenAlex account settings) gives
# a budget of $1 a day: a search costs $0.001, a lookup by id $0.0001.
OPENALEX_API_KEY=
OPENALEX_EMAIL=

# Semantic Scholar, a free source. Works without a key; a free key (form at
# https://www.semanticscholar.org/product/api#api-key-form) makes it far more reliable.
S2_API_KEY=

# Saving the OpenAlex budget (all optional)
# auto: below 20% of the day's budget, ask the free sources (arXiv, Europe PMC,
# Semantic Scholar) first and skip the extra searches. on / off force it.
PAPERSCOPE_SAVER=auto
# Keep API answers in a file so a repeated question costs nothing, even after a
# restart. Empty = off (nothing is written to disk). Example: data/cache/api-cache.jsonl
PAPERSCOPE_CACHE_FILE=
# how long answers stay in the file (days) and its size limit (MB)
PAPERSCOPE_CACHE_DAYS=7
PAPERSCOPE_CACHE_MB=200
